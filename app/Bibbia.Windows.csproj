<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Version>0.7.0</Version>
    <ApplicationIcon>Assets\Bibbia.ico</ApplicationIcon>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Bibbia.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="Assets\Bibbia.ico;Assets\Bibbia.png" />
    <Content Include="Assets\Bibbia.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\assets\fonts\*.ttf" Link="Assets\Fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="Assets\Bibbia.png" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250602001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.3916" />
    <Content Include="..\target\x86_64-pc-windows-msvc\release\bible_core.dll" Link="bible_core.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckRustCore" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('..\target\x86_64-pc-windows-msvc\release\bible_core.dll')" Text="Esegui scripts/build.ps1 dalla radice, con Rust x64 MSVC." />
  </Target>
  <Target Name="PublishCompiledWinUIResources" AfterTargets="Publish">
    <!-- The .NET Publish target omits generated WinUI PRI/XBF output in this
         SDK version. Preserve the same resource layout as the working build. -->
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="Indice WinUI non generato: $(ProjectPriFullPath)" />
    <ItemGroup>
      <_CompiledWinUIResource Include="$(TargetDir)**\*.pri;$(TargetDir)**\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(_CompiledWinUIResource)" DestinationFiles="@(_CompiledWinUIResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
