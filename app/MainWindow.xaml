<Window x:Class="Bibbia.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bibbia.Windows" Title="Bibbia">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root">
        <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False" SelectionChanged="NavigationChanged" OpenPaneLength="220"
            PaneTitle="Bibbia" AlwaysShowHeader="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Leggi" Tag="read" Icon="Read" IsSelected="True" />
                <NavigationViewItem Content="Cerca" Tag="search" Icon="Find" AutomationProperties.AutomationId="SearchNavigation" />
                <NavigationViewItem Content="La mia raccolta" Tag="saved" Icon="Bookmarks" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Aspetto e traduzioni" Tag="settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Grid Padding="28,20,28,16" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Text="UNO SPAZIO PER LA PAROLA" FontSize="11" CharacterSpacing="180"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="PageTitle" Text="Leggi con calma." Style="{ThemeResource TitleTextBlockStyle}" />
                </StackPanel>
                <InfoBar x:Name="ErrorBar" Grid.Row="1" IsOpen="False" Severity="Error" IsClosable="True" />
                <Grid Grid.Row="2">
                    <Grid x:Name="ReadPanel" RowSpacing="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="10" MaxWidth="850" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="BookPicker" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="BookChanged" AutomationProperties.Name="Libro" AutomationProperties.AutomationId="BookPicker" />
                            <ComboBox x:Name="ChapterPicker" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ChapterChanged" AutomationProperties.Name="Capitolo" />
                            <Button Grid.Column="2" Content="Aa" Click="AppearanceClick" AutomationProperties.Name="Aspetto della lettura" ToolTipService.ToolTip="Dimensione del testo e tema" />
                        </Grid>
                        <ListView x:Name="VerseList" Grid.Row="1" SelectionMode="Single" SelectionChanged="VerseSelected"
                            HorizontalContentAlignment="Stretch" MaxWidth="850" HorizontalAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Versetti del capitolo" AutomationProperties.AutomationId="VerseList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:VerseRow">
                                    <Border Padding="12,10" Margin="0,2" CornerRadius="6" Background="{x:Bind Fill}">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Number}" FontSize="12" Margin="0,6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" FontFamily="Georgia" FontSize="{x:Bind TextSize}"
                                                TextWrapping="Wrap" TextDecorations="{x:Bind Decorations}" IsTextSelectionEnabled="False" />
                                            <TextBlock Grid.Column="2" Text="{x:Bind Marker}" FontFamily="Segoe Fluent Icons" Margin="0,6,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock x:Name="ReadingLabel" HorizontalAlignment="Center" Margin="0,0,0,10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="PreviousButton" Grid.Row="1" Content="← Precedente" Click="PreviousClick" HorizontalAlignment="Left" />
                            <Button x:Name="NextButton" Grid.Row="1" Content="Successivo →" Click="NextClick" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <Grid x:Name="ResultsPanel" Visibility="Collapsed" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid x:Name="SearchBar" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" PlaceholderText="Una parola o una frase…" KeyDown="SearchKeyDown" AutomationProperties.Name="Cerca nella traduzione selezionata" AutomationProperties.AutomationId="SearchBox" />
                            <Button x:Name="SearchButton" Grid.Column="1" Content="Cerca" Click="SearchClick" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="SearchButton" />
                        </Grid>
                        <TextBlock x:Name="ResultStatus" Grid.Row="1" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ListView x:Name="ResultList" Grid.Row="2" IsItemClickEnabled="True" ItemClick="ResultClicked" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ResultList">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:SearchRow">
                                    <StackPanel Padding="12" Spacing="6">
                                        <TextBlock Text="{x:Bind Reference}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="17" />
                                        <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                        <StackPanel MaxWidth="600" HorizontalAlignment="Left" Spacing="18">
                            <TextBlock Text="Il tuo modo di leggere" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ComboBox x:Name="ThemePicker" Header="Tema" Width="240" SelectedIndex="0" SelectionChanged="ThemeChanged">
                                <ComboBoxItem Content="Come Windows" Tag="Default" /><ComboBoxItem Content="Chiaro" Tag="Light" /><ComboBoxItem Content="Scuro" Tag="Dark" />
                            </ComboBox>
                            <Slider x:Name="FontSlider" Header="Dimensione del testo" Minimum="14" Maximum="32" Value="20"
                                StepFrequency="1" SnapsTo="StepValues" Width="300" ValueChanged="FontChanged" />
                            <ComboBox x:Name="EditionPicker" Header="Traduzione" MinWidth="280" SelectionChanged="EditionChanged" />
                            <TextBlock Text="Diodati 1649: Bibbia completa in italiano, di pubblico dominio. È inclusa anche la KJV inglese. Puoi importare altre traduzioni JSON che hai il diritto di utilizzare. L’app funziona senza connessione."
                                TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button Content="Importa traduzione JSON…" Click="ImportClick" />
                            <TextBlock Text="I tuoi appunti restano sul dispositivo" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                            <TextBlock Text="Evidenziazioni, sottolineature, note, segnalibri e ultima lettura sono salvati in SQLite. Nessun account o tracciamento."
                                TextWrapping="Wrap" />
                            <Button Content="Apri cartella dati" Click="OpenDataClick" />
                            <TextBlock Text="Bibbia · 0.1&#x0a;Interfaccia Windows nativa · Motore Rust&#x0a;Progetto indipendente, non affiliato a YouVersion."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <TextBlock x:Name="StatusLabel" Grid.Row="3" FontSize="12" Text="Caricamento della Bibbia…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
