<Window x:Class="Bibbia.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Bibbia.Windows" Title="Bibbia">
    <Grid x:Name="Root" Background="{ThemeResource WindowSurfaceBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Grid x:Name="LegacyTitleBar" Visibility="Collapsed" Height="36" PointerPressed="TitleBarPointerPressed" Padding="12,0,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Image Source="Assets/Bibbia.png" Width="16" Height="16" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="Bibbia" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MinimizeWindowButton" Width="46" Height="36" Padding="0" CornerRadius="0" Background="Transparent" BorderThickness="0" Click="MinimizeWindowClick"><FontIcon Glyph="&#xE921;" FontSize="10" /></Button>
                <Button x:Name="MaximizeWindowButton" Width="46" Height="36" Padding="0" CornerRadius="0" Background="Transparent" BorderThickness="0" Click="MaximizeWindowClick"><FontIcon x:Name="MaximizeGlyph" Glyph="&#xE922;" FontSize="10" /></Button>
                <Button x:Name="CloseWindowButton" Width="46" Height="36" Padding="0" CornerRadius="0" Background="Transparent" BorderThickness="0" Click="CloseWindowClick">
                    <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C42B1C" /><SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" /></Button.Resources>
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>
        <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False" SelectionChanged="NavigationChanged" OpenPaneLength="220"
            PaneTitle="Bibbia" AlwaysShowHeader="False" FontFamily="{StaticResource ContentControlThemeFontFamily}">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Leggi" Tag="read" AutomationProperties.AutomationId="ReadNavigation" Icon="Read" IsSelected="True" />
                <NavigationViewItem Content="Cerca" Tag="search" Icon="Find" AutomationProperties.AutomationId="SearchNavigation" />
                <NavigationViewItem Content="La mia raccolta" AutomationProperties.AutomationId="SavedNavigation" Tag="saved" Icon="Bookmarks" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Aspetto e traduzioni" Tag="settings" AutomationProperties.AutomationId="SettingsNavigation" Icon="Setting" />
            </NavigationView.FooterMenuItems>
            <Grid Padding="28,20,28,16" RowSpacing="16" Background="{ThemeResource WindowSurfaceBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="5" MaxWidth="800" HorizontalAlignment="Stretch">
                    <TextBlock x:Name="EyebrowLabel" Text="UNO SPAZIO PER LA PAROLA" FontSize="11" CharacterSpacing="180"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="PageTitle" Text="Leggi con calma." Style="{ThemeResource TitleTextBlockStyle}" />
                </StackPanel>
                <InfoBar x:Name="ErrorBar" AutomationProperties.AutomationId="ErrorBar" Grid.Row="1" IsOpen="False" Severity="Error" IsClosable="True" />
                <Grid Grid.Row="2">
                    <Grid x:Name="ReadPanel" RowSpacing="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid ColumnSpacing="10" MaxWidth="800" HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ComboBox x:Name="BookPicker" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="BookChanged" AutomationProperties.Name="Libro" AutomationProperties.AutomationId="BookPicker" />
                            <ComboBox x:Name="ChapterPicker" Grid.Column="1" HorizontalAlignment="Stretch" SelectionChanged="ChapterChanged" AutomationProperties.Name="Capitolo" />
                            <Button Grid.Column="2" Content="Aa" Click="AppearanceClick" AutomationProperties.Name="Aspetto della lettura" ToolTipService.ToolTip="Dimensione del testo e tema" />
                        </Grid>
                        <Grid x:Name="BookStage" Grid.Row="1" MaxWidth="800" HorizontalAlignment="Stretch" Margin="0,3,0,8" AutomationProperties.AutomationId="BookStage">
                          <Border Background="{ThemeResource BookEdgeBrush}" CornerRadius="7" Margin="5,7,0,-5" />
                          <Border Background="{ThemeResource BookPaperBrush}" BorderBrush="{ThemeResource BookEdgeBrush}" BorderThickness="1" CornerRadius="7" Margin="2,3,2,-2" />
                          <Border Background="{ThemeResource BookPaperBrush}" BorderBrush="{ThemeResource BookEdgeBrush}" BorderThickness="1" CornerRadius="7">
                            <Grid x:Name="BookViewport" Background="{ThemeResource BookPaperBrush}" CornerRadius="7">
                              <Border Width="16" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#14000000" Offset="0" /><GradientStop Color="#00000000" Offset="1" /></LinearGradientBrush></Border.Background>
                              </Border>
                        <ListView x:Name="VerseList" SelectionMode="None" Margin="12,8,10,8"
                            HorizontalContentAlignment="Stretch" MaxWidth="800" HorizontalAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Versetti del capitolo" AutomationProperties.AutomationId="VerseList">
                            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:VerseRow">
                                    <Border Padding="12,8" Margin="0,3" CornerRadius="6">
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind Number}" FontSize="12" Margin="0,8,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <RichEditBox Grid.Column="1" Background="Transparent" Loaded="VerseEditorLoaded" Unloaded="VerseEditorUnloaded" DataContextChanged="VerseEditorDataContextChanged" SelectionChanged="VerseSelectionChanged" IsReadOnly="True" IsSpellCheckEnabled="False"
                                                FontFamily="{StaticResource ReadingFontFamily}" FontSize="{x:Bind TextSize, Mode=OneWay}" TextWrapping="Wrap" Padding="0" BorderThickness="0"
                                                ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.VerticalScrollMode="Disabled" UseSystemFocusVisuals="True">
                                                <RichEditBox.Resources>
                                                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                </RichEditBox.Resources>
                                            </RichEditBox>
                                            <Button Grid.Column="2" Content="⋯" Tag="{x:Bind Index}" Click="VerseMenuClick" VerticalAlignment="Top" AutomationProperties.AutomationId="{x:Bind MenuId}"
                                                Padding="6" MinWidth="28" Background="Transparent" BorderThickness="0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                              <Canvas x:Name="TurnCanvas" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
                            </Grid>
                          </Border>
                        </Grid>
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel HorizontalAlignment="Center" Spacing="4" Margin="0,0,0,8">
                                <TextBlock x:Name="ReadingLabel" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Button x:Name="QuickEditionButton" AutomationProperties.AutomationId="QuickEditionButton" Padding="10,4" Background="Transparent" BorderThickness="0" FontSize="12" MaxWidth="400">
                                    <Button.Flyout><MenuFlyout Opening="QuickEditionsOpening" /></Button.Flyout>
                                </Button>
                            </StackPanel>
                            <Button x:Name="PreviousButton" AutomationProperties.AutomationId="PreviousChapter" Grid.Row="1" Content="← Precedente" Click="PreviousClick" HorizontalAlignment="Left" />
                            <Button x:Name="NextButton" AutomationProperties.AutomationId="NextChapter" Grid.Row="1" Content="Successivo →" Click="NextClick" HorizontalAlignment="Right" />
                        </Grid>
                    </Grid>
                    <Grid x:Name="ResultsPanel" Visibility="Collapsed" RowSpacing="16">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid x:Name="SearchBar" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" PlaceholderText="Una parola o una frase…" KeyDown="SearchKeyDown" AutomationProperties.Name="Cerca nella traduzione selezionata" AutomationProperties.AutomationId="SearchBox" />
                            <Button x:Name="SearchButton" Grid.Column="1" Content="Cerca" Click="SearchClick" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="SearchButton" />
                        </Grid>
                        <Grid Grid.Row="1" ColumnSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock x:Name="ResultStatus" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="SavedPreviousPage" Grid.Column="1" Content="←" Click="SavedPreviousClick" Visibility="Collapsed" AutomationProperties.AutomationId="SavedPreviousPage" />
                            <Button x:Name="SavedNextPage" Grid.Column="2" Content="→" Click="SavedNextClick" Visibility="Collapsed" AutomationProperties.AutomationId="SavedNextPage" />
                        </Grid>
                        <ListView x:Name="ResultList" Grid.Row="2" IsItemClickEnabled="True" ItemClick="ResultClicked" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="ResultList">
                            <ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel CacheLength="0.5" /></ItemsPanelTemplate></ListView.ItemsPanel>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="local:SearchRow">
                                    <StackPanel Padding="12" Spacing="6">
                                        <TextBlock Text="{x:Bind Reference}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" FontSize="17" />
                                        <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed">
                        <StackPanel MaxWidth="600" HorizontalAlignment="Left" Spacing="18">
                            <TextBlock x:Name="AppearanceLabel" Text="Il tuo modo di leggere" Style="{ThemeResource SubtitleTextBlockStyle}" />
                            <ComboBox x:Name="AppLanguagePicker" Header="Lingua dell’app" Width="280" SelectionChanged="AppLanguageChanged" AutomationProperties.AutomationId="AppLanguagePicker"><ComboBoxItem Content="Italiano" Tag="it" /><ComboBoxItem Content="English" Tag="en" /></ComboBox>
                            <ComboBox x:Name="ThemePicker" AutomationProperties.AutomationId="ThemePicker" Header="Tema" Width="240" SelectedIndex="0" SelectionChanged="ThemeChanged">
                                <ComboBoxItem Content="Come Windows" Tag="Default" /><ComboBoxItem Content="Chiaro" Tag="Light" /><ComboBoxItem Content="Scuro" Tag="Dark" />
                            </ComboBox>
                            <Slider x:Name="FontSlider" AutomationProperties.AutomationId="FontSlider" Header="Dimensione del testo" Minimum="14" Maximum="32" Value="20"
                                StepFrequency="1" SnapsTo="StepValues" Width="300" ValueChanged="FontChanged" />
                            <ComboBox x:Name="BibleLanguagePicker" AutomationProperties.AutomationId="BibleLanguagePicker" Header="Lingua della Bibbia" Width="280" SelectionChanged="BibleLanguageChanged"><ComboBoxItem Content="Italiano" Tag="it" /><ComboBoxItem Content="English" Tag="en" /><ComboBoxItem Content="Tutte" Tag="all" /></ComboBox>
                            <ComboBox x:Name="EditionPicker" DisplayMemberPath="Name" AutomationProperties.AutomationId="EditionPicker" Header="Traduzione" MinWidth="280" SelectionChanged="EditionChanged" />
                            <TextBlock x:Name="EditionDetails" TextWrapping="Wrap" />
                            <HyperlinkButton Content="CEI 2008 · BibbiaEDU" NavigateUri="https://www.bibbiaedu.it/site/twig/templates/v3/html/notelegali/" />
                            <TextBlock x:Name="CatalogDescription" Text="CEI 2008 e Martini: Bibbie cattoliche italiane complete, 73 libri. Diodati e KJV: 66 libri. Raccolta estesa in inglese: 83 libri/sezioni, compresi apocrifi, 1 Enoc e Giubilei. La lingua dell’app è indipendente dal testo."
                                TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Button x:Name="ImportButton" Content="Importa traduzione JSON…" Click="ImportClick" />
                            <TextBlock x:Name="PrivacyTitle" Text="I tuoi appunti restano sul dispositivo" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,12,0,0" />
                            <TextBlock x:Name="PrivacyDescription" Text="Evidenziazioni, sottolineature, note, segnalibri e ultima lettura sono salvati in SQLite. Nessun account o tracciamento."
                                TextWrapping="Wrap" />
                            <Button x:Name="OpenDataButton" Content="Apri cartella dati" Click="OpenDataClick" />
                            <TextBlock x:Name="AboutLabel" Text="Bibbia · 0.4&#x0a;Interfaccia Windows nativa · Motore Rust&#x0a;Progetto indipendente, non affiliato a YouVersion."
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
                <TextBlock x:Name="StatusLabel" Grid.Row="3" FontSize="12" Text="Caricamento della Bibbia…" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
